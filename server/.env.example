PORT=5001

# Admin dashboard (/admin). Use a long random password.
ADMIN_PASSWORD=change-me-to-a-long-password
# Secret used to sign admin login tokens (any long random string)
TOKEN_SECRET=change-me-too

# Optional: MongoDB (Atlas free tier works). If empty, messages are saved in server/data/db.json
MONGO_URI=

# Optional: email notification when someone contacts you.
# Gmail: enable 2-step verification, then create an "App password".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=vinodchauhan3809@gmail.com
SMTP_PASS=
NOTIFY_TO=vinodchauhan3809@gmail.com

# Comma-separated allowed origins when frontend is hosted separately (e.g. Vercel)
CORS_ORIGIN=http://localhost:5173
